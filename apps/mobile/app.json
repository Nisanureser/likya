{
  "expo": {
    "name": "Patika",
    "slug": "patika",
    "version": "0.1.0",
    "scheme": "patika",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.patika.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["location", "fetch", "processing"],
        "NSLocationWhenInUseUsageDescription": "Konumun, rota üzerindeki yerini ve bir sonraki su/konaklama noktasına mesafeyi göstermek için kullanılır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Yürüyüş modunda arka planda konum, rotadan sapma uyarısı ve varış onayı güvenliği için kullanılır. Konumun başkalarına yalnız sen açarsan ve kabalaştırılmış olarak gösterilir."
      }
    },
    "android": {
      "package": "com.patika.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Yürüyüş modunda arka planda konum, rotadan sapma uyarısı ve varış onayı güvenliği için kullanılır.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      ["expo-notifications", { "icon": "./assets/icon.png" }],
      "expo-background-task",
      "@maplibre/maplibre-react-native"
    ],
    "extra": { "eas": { "projectId": "" } }
  }
}
